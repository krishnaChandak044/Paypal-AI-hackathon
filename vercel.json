{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "npm --prefix web ci && npm --prefix web run build",
      "functions": {
        "app/main.py": {
          "includeFiles": "web/dist/**",
          "excludeFiles": "{tests/**,demo/**,docs/**,*.db,*.db-shm,*.db-wal}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
