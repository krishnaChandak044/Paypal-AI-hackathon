# PayPal Sandbox only — never place live credentials here.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Meta Model API (use synthetic/de-identified data only).
AI_PROVIDER=meta
AI_MODEL=muse-spark-1.3
META_MODEL_API_KEY=

# Optional PayPal AI Hackathon sponsor integration for resource/product search.
# Claim a participant key and promo at Channel3; 20,000 product searches are included.
CHANNEL3_API_KEY=

# Set a long random value before first launch. Bootstrap works once.
BOOTSTRAP_SECRET=
# Only synthetic requests may be sent to Meta during development.
ALLOW_SYNTHETIC_AI=false
DATABASE_URL=sqlite:///./reliefrail.db
# Register /paypal/webhooks for PAYMENT.CAPTURE.COMPLETED in PayPal sandbox.
PAYPAL_WEBHOOK_ID=
# Public intake should be enabled only behind rate limiting and abuse controls.
ENABLE_PUBLIC_INTAKE=false
# Only trust X-Forwarded-For behind a controlled reverse proxy.
TRUST_PROXY_IP=false
